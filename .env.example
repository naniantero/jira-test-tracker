# Optional: a postgres:// or postgresql:// URL selects PostgreSQL (DATABASE_PATH is then ignored);
# unset or empty selects SQLite. TLS via URL parameters, e.g. ?sslmode=verify-full.
# Percent-encode special characters in the password (such as / ? # @ : %), e.g. / as %2F.
# DATABASE_URL=postgres://user:password@host:5432/tracker

# Path to the SQLite database file, used when DATABASE_URL is empty
# (default: ./data/app.db; use /data/app.db in the container)
DATABASE_PATH=./data/app.db

# Optional: bucket for attachments. Unset disables attachments (no uploads, none shown).
#   Azure Blob Storage: https://<account>.blob.core.windows.net/<container>[/<prefix>]
#     (credentials from DefaultAzureCredential: workload identity, managed identity or `az login`)
#   S3 or S3-compatible: s3://<bucket>[/<prefix>][?endpoint=https://minio.example.com&region=us-east-1]
#     (credentials from the AWS SDK's default chain, e.g. AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY)
# ATTACHMENTS_BUCKET_URL=

# Secret used by Better Auth to sign sessions. Required, at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app. Required.
BETTER_AUTH_URL=http://localhost:4100

# Optional: bootstrap admin account. Set both or neither.
# Username 3-32 characters.
ADMIN_USERNAME=
# Password at least 10 characters.
ADMIN_PASSWORD=

# Docker Compose only: host port to publish (default 4100).
# APP_PORT=4100
