{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "group": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 50000
        }
      },
      "required": ["key", "title"]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 50000
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 5000
            },
            "maxItems": 100
          },
          "reference": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["key", "title"]
      }
    }
  },
  "required": ["schemaVersion", "group", "cases"]
}
