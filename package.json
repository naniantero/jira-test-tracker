{
  "name": "test-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "next build && node scripts/build-cli.mjs",
    "cli": "tsx src/cli/main.ts",
    "start": "next start -p 4100",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "schema:generate": "tsx scripts/gen-sync-schema.ts",
    "db:generate": "npm run db:generate:sqlite && npm run db:generate:pg",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle.pg.config.ts",
    "auth:generate:sqlite": "JITI_FS_CACHE=false npx auth@1.7.25 generate --config src/lib/auth/cli-config.sqlite.ts --output src/lib/db/schemas/auth-sqlite.ts -y",
    "auth:generate:pg": "JITI_FS_CACHE=false npx auth@1.7.25 generate --config src/lib/auth/cli-config.pg.ts --output src/lib/db/schemas/auth-pg.ts -y"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.25",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "^1.65.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
